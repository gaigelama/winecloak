                                     ULONG *required_len )
 {
@@ -2516,6 +2538,35 @@ static NTSTATUS enum_firmware_info( SYSTEM_FIRMWARE_TABLE_INFORMATION *sfti, ULO
         *(UINT *)sfti->TableBuffer = 0;
