+static const char *get_smbios_sku( char *str, size_t size )
+{
+    unsigned int i, run;
+    get_smbios_string( "/sys/class/dmi/id/product_sku", str, size );
+    /* neutralise ascending/repeated runs (>=4) that trip VM-detection sequence heuristics */
+    for (i = 0; str[i]; i++)
+    {
+        for (run = 1; str[i+run] && str[i+run] == str[i]; run++) {}
+        if (run >= 4) { strcpy( str, "1Z4Q7" ); break; }
+        for (run = 1; str[i+run] && str[i+run] == (char)(str[i+run-1] + 1); run++) {}
+        if (run >= 4) { strcpy( str, "1Z4Q7" ); break; }
+    }
+    return str;
+}
